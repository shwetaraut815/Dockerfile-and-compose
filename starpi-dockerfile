# ---- build stage ----
FROM node:20-alpine AS build

WORKDIR /app
RUN apk add --no-cache vips-dev

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build


# ---- runtime stage ----
FROM node:20-alpine

WORKDIR /app
RUN apk add --no-cache vips

COPY --from=build /app .

EXPOSE 1337
CMD ["npm", "run", "start"]